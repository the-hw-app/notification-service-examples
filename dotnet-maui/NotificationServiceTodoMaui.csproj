<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>NotificationServiceTodoMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>13</LangVersion>

		<!-- Display name -->
		<ApplicationTitle>Notification Service Todo</ApplicationTitle>

		<!-- App Identifier. MUST match the package_name / bundle id in your
		     google-services.json and GoogleService-Info.plist. -->
		<ApplicationId>com.notificationservice.tododemo</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Plugin.Firebase requires these minimum platform versions. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4F46E5" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4F46E5" BaseSize="128,128" />

		<!-- Images / assets -->
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Plugin.Firebase: meta package pulls in Core; CloudMessaging is the
		     FCM piece this app uses. Versions are the current stable releases
		     (min baseline .NET 9). -->
		<PackageReference Include="Plugin.Firebase" Version="4.2.1" />
		<PackageReference Include="Plugin.Firebase.CloudMessaging" Version="4.0.1" />
	</ItemGroup>

	<!-- Android: google-services.json must be supplied by the developer (see
	     README). It is git-ignored; drop it at Platforms/Android/google-services.json. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
	</ItemGroup>

	<!-- iOS: GoogleService-Info.plist must be supplied by the developer (see
	     README). It is git-ignored; drop it at Platforms/iOS/GoogleService-Info.plist. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist" Condition="Exists('Platforms\iOS\GoogleService-Info.plist')" />
	</ItemGroup>

</Project>
