<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NotificationServiceTodoMaui.Models"
             x:Class="NotificationServiceTodoMaui.MainPage"
             Title="Notification Service Todo">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Padding="16"
          RowSpacing="12">

        <!-- Notification / Notification Service registration bar -->
        <Border Grid.Row="0"
                Padding="12"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light=#EEF0FF, Dark=#22243A}">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="StatusLabel"
                       Text="Notifications not enabled"
                       FontSize="14" />
                <Button x:Name="EnableButton"
                        Text="Enable Notifications"
                        Clicked="OnEnableNotificationsClicked" />
            </VerticalStackLayout>
        </Border>

        <!-- Add row -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <Entry x:Name="NewTodoEntry"
                   Grid.Column="0"
                   Placeholder="Add a todo…"
                   ReturnCommand="{Binding Source={x:Reference AddButton}, Path=Command}"
                   Completed="OnAddClicked" />
            <Button x:Name="AddButton"
                    Grid.Column="1"
                    Text="Add"
                    Clicked="OnAddClicked" />
        </Grid>

        <BoxView Grid.Row="2"
                 HeightRequest="1"
                 Color="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}" />

        <!-- Todo list -->
        <CollectionView Grid.Row="3"
                        x:Name="TodoList"
                        ItemsSource="{Binding}">
            <CollectionView.EmptyView>
                <Label Text="No todos yet"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Opacity="0.6" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Grid Padding="0,8"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding Done, Mode=OneWay}"
                                  CheckedChanged="OnTodoCheckedChanged"
                                  VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Done}"
                                             Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Button Grid.Column="2"
                                Text="Delete"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#B00020, Dark=#FF6E6E}"
                                Clicked="OnDeleteClicked"
                                VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
